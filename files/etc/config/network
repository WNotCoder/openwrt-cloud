
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '0004a8f3784a3e554f9aaa22c1838c8989ec'
	option packet_steering '0'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ip6assign '64'
	option ip6ifaceid 'eui64'
	list ipaddr '192.168.100.1/24'
	option multipath 'off'

config interface 'wan'
	option device 'wan'
	option proto 'pppoe'
	option username '0000000000'
	option password '00000'
	option ipv6 'auto'
	option norelease '1'
	option multipath 'off'

config interface 'wan6'
	option device 'wan'
	option proto 'dhcpv6'
	option reqaddress 'try'
	option reqprefix 'auto'

